{% comment %}
  TikTok Shop style product protections section
  Mobile-first optimized with Tailwind CSS
  Features: Horizontal scrollable protection badges
{% endcomment %}

<div class="bg-gray-900 text-white px-4 py-6">
  {% comment %} Section Title {% endcomment %}
  <h2 class="text-2xl font-bold mb-4">
    {{ section.settings.title | default: "Tes protections" }}
  </h2>

  {% comment %} Horizontal Scrollable Protection Features {% endcomment %}
  <div class="flex gap-4 overflow-x-auto pb-2 -mx-4 px-4 scrollbar-hide" style="scrollbar-width: none; -ms-overflow-style: none;">
    {% comment %} Protection 1: Secure Payments {% endcomment %}
    <div class="flex-shrink-0 w-32 text-center">
      <div class="flex justify-center mb-2">
        <div class="w-12 h-12 rounded-full bg-teal-500/20 flex items-center justify-center">
          <svg class="w-6 h-6 text-teal-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
          </svg>
        </div>
      </div>
      <p class="text-xs text-gray-300 leading-tight">
        {{ section.settings.protection_1_text | default: "Paiements sécurisés" }}
      </p>
    </div>

    {% comment %} Protection 2: Accelerated Refund {% endcomment %}
    <div class="flex-shrink-0 w-32 text-center">
      <div class="flex justify-center mb-2">
        <div class="w-12 h-12 rounded-full bg-teal-500/20 flex items-center justify-center">
          <svg class="w-6 h-6 text-teal-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
          </svg>
        </div>
      </div>
      <p class="text-xs text-gray-300 leading-tight">
        {{ section.settings.protection_2_text | default: "Remboursement accéléré en cas d'articles perdus ou endommagés" }}
      </p>
    </div>

    {% comment %} Protection 3: Customer Protection {% endcomment %}
    <div class="flex-shrink-0 w-32 text-center">
      <div class="flex justify-center mb-2">
        <div class="w-12 h-12 rounded-full bg-teal-500/20 flex items-center justify-center">
          <svg class="w-6 h-6 text-teal-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
          </svg>
        </div>
      </div>
      <p class="text-xs text-gray-300 leading-tight">
        {{ section.settings.protection_3_text | default: "Protection des clients" }}
      </p>
    </div>

    {% comment %} Protection 4: 24/7 Support {% endcomment %}
    <div class="flex-shrink-0 w-32 text-center">
      <div class="flex justify-center mb-2">
        <div class="w-12 h-12 rounded-full bg-teal-500/20 flex items-center justify-center">
          <svg class="w-6 h-6 text-teal-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M18.364 5.636l-3.536 3.536m0 5.656l3.536 3.536M9.172 9.172L5.636 5.636m3.536 9.192l-3.536 3.536M21 12a9 9 0 11-18 0 9 9 0 0118 0zm-5 0a4 4 0 11-8 0 4 4 0 018 0z" />
          </svg>
        </div>
      </div>
      <p class="text-xs text-gray-300 leading-tight">
        {{ section.settings.protection_4_text | default: "Assistance cl 24 h/24, 7 j/7" }}
      </p>
    </div>

    {% comment %} Expandable Chevron {% endcomment %}
    <button
      type="button"
      class="flex-shrink-0 flex items-center justify-center w-10 h-10 rounded-full bg-gray-800 hover:bg-gray-700 transition-colors self-center"
      aria-label="View all protections"
      onclick="alert('{{ section.settings.expand_message | default: "View all protections" }}')"
    >
      <svg class="w-5 h-5 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
      </svg>
    </button>
  </div>
</div>

<style>
  .scrollbar-hide::-webkit-scrollbar {
    display: none;
  }
</style>

{% schema %}
{
  "name": "Product Protections",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Section title",
      "default": "Tes protections"
    },
    {
      "type": "text",
      "id": "protection_1_text",
      "label": "Protection 1 text",
      "default": "Paiements sécurisés"
    },
    {
      "type": "text",
      "id": "protection_2_text",
      "label": "Protection 2 text",
      "default": "Remboursement accéléré en cas d'articles perdus ou endommagés"
    },
    {
      "type": "text",
      "id": "protection_3_text",
      "label": "Protection 3 text",
      "default": "Protection des clients"
    },
    {
      "type": "text",
      "id": "protection_4_text",
      "label": "Protection 4 text",
      "default": "Assistance cl 24 h/24, 7 j/7"
    },
    {
      "type": "text",
      "id": "expand_message",
      "label": "Expand button message"
    }
  ],
  "presets": [
    {
      "name": "Product Protections"
    }
  ]
}
{% endschema %}

